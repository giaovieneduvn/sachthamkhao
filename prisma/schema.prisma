// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FileType {
  pdf
  docx
  pptx
}

model Ebook {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  description   String?  @db.Text
  fileType      FileType
  fileKey       String // path inside the Supabase Storage bucket
  fileSizeBytes Int
  coverUrl      String?
  price         Decimal  @default(0) @db.Decimal(12, 2) // 0 = free
  published     Boolean  @default(true)
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@index([published])
}

enum OrderStatus {
  pending
  paid
  cancelled
}

model Order {
  id         String      @id @default(cuid())
  code       String      @unique // shown as the bank transfer note (VietQR addInfo)
  ebookId    String
  ebook      Ebook       @relation(fields: [ebookId], references: [id])
  amount     Decimal     @db.Decimal(12, 2)
  buyerEmail String?
  status       OrderStatus @default(pending)
  createdAt    DateTime    @default(now())
  paidAt       DateTime?
  downloadedAt DateTime? // set on first successful download; blocks reuse of the order link

  @@index([status])
}
