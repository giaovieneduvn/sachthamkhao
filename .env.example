# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. On Render, use Supabase's "Session pooler" string
# (Project Settings -> Database) — Render's free plan has no IPv6 egress, and
# Supabase's direct connection is IPv6-only. Locally either works.
DATABASE_URL="postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase Project URL and service_role key (Project Settings -> API).
# Used for Storage uploads — NOT the same as DATABASE_URL. Must be the
# service_role key (secret), not the anon/public key.
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Password for the /admin dashboard (upload/manage ebooks).
ADMIN_PASSWORD=""
