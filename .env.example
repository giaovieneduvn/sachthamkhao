# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. Supabase "Direct connection" (Project Settings ->
# Database) đã test hoạt động tốt. Nếu deploy host không hỗ trợ IPv6, đổi sang
# "Session pooler" (KHÔNG dùng "Transaction pooler" - thiếu advisory lock).
DATABASE_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# Accesstrade publisher API key: https://pub.accesstrade.vn/publisher_profile/personal_info
ACCESSTRADE_API_KEY=""

# Random secret required in the "x-cron-secret" header to trigger /api/cron/sync
CRON_SECRET=""
